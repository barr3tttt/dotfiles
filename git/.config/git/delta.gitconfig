# delta git pager (tracked in dotfiles, stow package: git).
# Wired in with: git config --global include.path '~/.config/git/delta.gitconfig'
# (only after git-delta is installed - core.pager errors if the binary is missing).
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true    # n / N jump between files in a diff
	line-numbers = true
	syntax-theme = Dracula    # bat's built-in Dracula (matches the mac)
	file-style = "#bd93f9" bold
	file-decoration-style = "#44475a" ul
	hunk-header-style = "#6272a4" line-number
	hunk-header-decoration-style = "#44475a" box
	minus-style = syntax "#3d2b3d"
	plus-style = syntax "#2b3d33"
	line-numbers-minus-style = "#ff5555"
	line-numbers-plus-style = "#50fa7b"
	line-numbers-zero-style = "#6272a4"
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
